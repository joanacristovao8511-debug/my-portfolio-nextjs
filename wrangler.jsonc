{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "my-portfolio-nextjs",
  "compatibility_date": "2026-09-20",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "main": "vinext/server/app-router-entry",
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none"
  },
  "vars": {
    "NODE_ENV": "production",
    "NEXT_TELEMETRY_DISABLED": "1",
    "OPENROUTER_MODEL": "openrouter/free",
    "OPENROUTER_BASE_URL": "https://openrouter.ai/api/v1"
  }
  // Sensitive values are configured as Cloudflare Worker secrets.
  // They are intentionally not declared in this file so existing dashboard secrets
  // are preserved when deploying new Worker versions.
  // Required runtime secrets: DATABASE_URL, AUTH_SECRET, OPENROUTER_API_KEY,
  // ADMIN_EMAIL, ADMIN_PASSWORD
}